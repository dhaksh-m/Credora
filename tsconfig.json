{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["packages/shared-types/src/*"]
    },
    "types": ["node", "electron-vite/node"]
  },
  "include": ["src/**/*", "electron/**/*", "packages/**/*", "database/**/*", "scripts/**/*", "tests/**/*"],
  "exclude": ["node_modules", "out", "dist", "release", "electron-dist"]
}
